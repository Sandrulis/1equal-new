# Copy to .env.local and fill in values from the Supabase dashboard.

# Local dev stays on localhost. A production build must use the public https origin.
# If this is missing or local during `next build`, metadata falls back to https://1equal.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3130

# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Project Settings → Database → Database password
# Used only by npm run db:migrate. Never expose this in the browser.
SUPABASE_DB_PASSWORD=your_database_password

# Sentry. DSN comes from the project Client Keys page. It is public by design.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SUPABASE_DB_REGION=eu-west-1
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
